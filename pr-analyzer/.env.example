# ---------------------------------------------------------------------------
# pr-analyzer environment variables (example)
#
# Copy to .env and fill in (.env is git-ignored and never committed):
#     cp .env.example .env
#
# The PR analyzer works without an LLM. Behavioral explanations are optional;
# without BEHAVIOR_LLM_API_KEY the detector uses its rule-based summary.
# ---------------------------------------------------------------------------

# ---- GitHub API ----
# Anonymous: 60 requests/hour; with a token: 5000 requests/hour.
# Read-only scope is enough (PR metadata, diff, and repository source).
GITHUB_TOKEN=

# Optional: API root for GitHub Enterprise or a proxy gateway.
# Defaults to https://api.github.com when empty.
# GITHUB_API_URL=https://api.github.com

# ---- Optional behavioral-change explanation (OpenAI-compatible endpoint) ----
# BEHAVIOR_LLM_API_KEY=
# BEHAVIOR_LLM_MODEL=gpt-4o-mini
# BEHAVIOR_LLM_BASE_URL=https://api.openai.com/v1
